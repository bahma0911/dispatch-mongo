{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dispatch-nega",
  "main": "worker.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "API_ORIGIN": "https://dispatch-mongo.onrender.com"
  }
}